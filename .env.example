# =================================================================
# CONFIGURAÇÕES DO AGENTE DE AUTOMAÇÃO (LAB-DIO)
# =================================================================

# --- Google AI Studio (Gemini) ---
# Obtenha sua chave em: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=seu_api_key_aqui

# --- Integração Trello ---
# Obtenha sua chave e token em: https://trello.com/app-key
TRELLO_API_KEY=sua_trello_key_aqui
TRELLO_TOKEN=seu_trello_token_aqui

# --- Configurações do Quadro (Opcional) ---
# ID do quadro onde o agente deve operar
TRELLO_BOARD_ID=id_do_seu_quadro_aqui

# --- Configurações de Log ---
# Níveis: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
